{
  "launch": {
    "gpus": [
      2
    ],
    "work_dir": "results/screening_shallow_gated",
    "data_root": "../datasets/BraTS2020",
    "manifest": "data/brats2020/split_seed42.json",
    "cache_dir": "data/brats2020/cache",
    "log_dir": "logs",
    "save_predictions": true
  },
  "input_size": 256,
